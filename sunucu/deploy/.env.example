# cp .env.example .env  ->  değerleri doldur. .env DOSYASINI ASLA GIT'E KOYMA (chmod 600).

# --- Caddy / alan adı ---
ALAN_ADI=oyun.ornek.com
ACME_EPOSTA=sen@ornek.com

# --- Giriş sağlayıcıları (sunucu.dart okur) ---
EMLAKDEAL_GOOGLE_CLIENT_ID=
EMLAKDEAL_FACEBOOK_APP_ID=

# --- Aşağıdakiler sunucu sürümüne eklenen özellikler içindir; sunucu.dart'ta
# okunduğunu `grep -n "Platform.environment" sunucu/bin/*.dart` ile doğrula.
# Okunmuyorsa boş bırakmak zararsızdır. ---
FB_APP_SECRET=
# Yönetim uçları (/api/yonetim/*) için uzun rastgele anahtar:  openssl rand -hex 32
YONETIM_ANAHTAR=
# Gizlilik/destek sayfasında görünecek e-posta
DESTEK_EPOSTA=

# --- Yedekleme (backup.sh okur; host'ta /etc/emlakdeal/yedek.env olarak da kullanılabilir) ---
# Bildirim: Healthchecks.io ping adresi (https://hc-ping.com/UUID)
HC_YEDEK_URL=
HC_SAGLIK_URL=
# Rclone hedefi (örn. b2:emlakdeal-yedek veya s3:kova/emlakdeal); boşsa atlanır
RCLONE_HEDEF=
# Ev PC'sine scp (örn. soner@192.168.1.10:/yedek/emlakdeal); boşsa atlanır
SCP_HEDEF=
